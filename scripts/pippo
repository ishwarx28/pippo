#!/bin/sh
# Owns the supported development and production commands.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

usage() {
  echo "usage: $0 run --dev | run --prod | build" >&2
  exit 2
}

build() {
  cargo tauri build --no-bundle
}

case "${1:-}" in
  run)
    [ "$#" -eq 2 ] || usage
    case "$2" in
      --dev) exec cargo tauri dev ;;
      --prod)
        build
        exec target/release/pippo
        ;;
      *) usage ;;
    esac
    ;;
  build)
    [ "$#" -eq 1 ] || usage
    build
    ;;
  *) usage ;;
esac
