{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pippo",
  "version": "0.1.0",
  "identifier": "app.pippo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ui",
    "beforeBuildCommand": "npm run build --prefix ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "pippo",
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
